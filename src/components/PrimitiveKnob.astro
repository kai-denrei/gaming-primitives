---
// Placeholder host. Runtime injects actual knob nodes.
---
<div class="demo-knobs" role="group" aria-label="Demo parameters"></div>

<style>
  /* Two-column grid keeps the knob row compact on mobile so the canvas + knobs
     fit above the fold. Single column only on the narrowest phones (<360px). */
  .demo-knobs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 0.8rem;
    padding: 0.3rem 0 0.2rem;
  }
  :global(.demo-knobs .knob) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    min-width: 0;
  }
  :global(.demo-knobs .knob label) {
    color: var(--fg-muted);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4em;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.demo-knobs input[type=range]) {
    width: 100%;
    min-height: 32px;
    margin: 0;
    accent-color: var(--accent);
  }
  :global(.demo-knobs .knob-readout) {
    color: var(--fg);
    font-size: 0.7rem;
    min-width: 0;
    text-align: right;
    flex-shrink: 0;
  }
  :global(.demo-knobs .knob-toggle) {
    padding: 0.4em 0.7em;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--fg);
    cursor: pointer;
    min-height: 36px;
    font-family: inherit;
    font-size: 0.72rem;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.demo-knobs .knob-toggle[data-on=true]) { background: var(--accent); color: #000; }
  :global(.demo-knobs .knob-enum) {
    display: flex;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px;
  }
  :global(.demo-knobs .knob-enum button) {
    flex: 1;
    padding: 0.3em 0.4em;
    background: transparent;
    border: 0;
    color: var(--fg-muted);
    font-family: inherit;
    font-size: 0.7rem;
    cursor: pointer;
    min-height: 30px;
    min-width: 0;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.demo-knobs .knob-enum button[data-on=true]) { background: var(--accent); color: #000; }

  @media (max-width: 359px) {
    .demo-knobs { grid-template-columns: 1fr; }
  }

  @media (min-width: 641px) {
    .demo-knobs { gap: 0.7rem 1.1rem; padding: 0.4rem 0; }
    :global(.demo-knobs .knob) { font-size: 0.8rem; }
    :global(.demo-knobs input[type=range]) { min-height: 36px; }
    :global(.demo-knobs .knob-readout) { font-size: 0.78rem; }
    :global(.demo-knobs .knob-toggle),
    :global(.demo-knobs .knob-enum button) { font-size: 0.78rem; }
  }
</style>
