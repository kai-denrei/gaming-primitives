---
import '../styles/tokens.css';
import '../styles/prose.css';
import InstallButton from '../components/InstallButton.astro';
import UpdateToast from '../components/UpdateToast.astro';
import pkg from '../../package.json';
import { execSync } from 'node:child_process';

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
}
const { title, description = 'A catalog of irreducible gameplay primitives.', themeColor = '#0d1117' } = Astro.props;
const base = import.meta.env.BASE_URL;

const buildSha = (() => {
  try { return execSync('git rev-parse --short HEAD').toString().trim(); }
  catch { return 'dev'; }
})();
const buildDate = (() => {
  try { return execSync('git log -1 --format=%cd --date=short').toString().trim(); }
  catch { return new Date().toISOString().slice(0, 10); }
})();
const repoUrl = 'https://github.com/kai-denrei/gaming-primitives';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content={themeColor} />
  <meta name="color-scheme" content="dark" />
  <meta name="description" content={description} />
  <link rel="manifest" href={`${base}manifest.webmanifest`} />
  <link rel="icon" href={`${base}icons/favicon-32.png`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon-180.png`} sizes="180x180" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Gaming Primitives" />
  <title>{title}</title>
  <script define:vars={{ base }}>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(base + 'sw.js', { scope: base }).catch(() => {});
      });
    }
  </script>
  <script is:inline>
    // Global deeplink delegator. Any element with [data-deeplink] triggers
    // a share/copy of the current URL on click. Uses navigator.share on
    // mobile (opens the iOS share sheet) and clipboard.writeText otherwise.
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-deeplink]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const url = window.location.href;
      try {
        if (navigator.share && /Mobi|Android|iPhone|iPad/.test(navigator.userAgent)) {
          await navigator.share({ url, title: document.title }).catch(() => {});
        } else if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(url);
        }
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1200);
      } catch (_) {}
    });
  </script>
</head>
<body>
  <header class="topbar">
    <a href={base} class="brand">gaming primitives</a>
    <nav class="topnav">
      <a href={`${base}p/`}>primitives</a>
      <a href={`${base}a/`}>applied</a>
      <a href={`${base}era/`}>era</a>
      <a href={`${base}about/`}>about</a>
      <InstallButton />
    </nav>
  </header>
  <main><slot /></main>
  <footer class="sitefoot">
    <span class="metadata">primitives ≠ genres ≠ games. <a href={`${base}about/`}>why this exists</a></span>
    <span class="build-info">
      <span class="build-version">v{pkg.version}</span>
      <span class="build-sep">·</span>
      <a class="build-sha" href={`${repoUrl}/commit/${buildSha}`} rel="noopener" target="_blank">{buildSha}</a>
      <span class="build-sep">·</span>
      <span class="build-date">{buildDate}</span>
    </span>
  </footer>
  <UpdateToast />
  <style>
    /* Mobile-first compact chrome — topbar in one row, small mono. Desktop
       (>=641px) loosens to the original spacing in the @media below. */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1rem;
      padding-top: calc(0.6rem + env(safe-area-inset-top, 0px));
      padding-left: max(1rem, env(safe-area-inset-left, 0px));
      padding-right: max(1rem, env(safe-area-inset-right, 0px));
      border-bottom: 1px solid var(--border);
    }
    .brand { font-family: var(--font-mono); font-weight: 600; color: var(--fg); text-decoration: none; font-size: 0.85rem; line-height: 1.1; flex-shrink: 0; }
    .topnav { display: flex; align-items: center; gap: 0.7rem; }
    .topnav a { font-family: var(--font-mono); color: var(--fg-muted); text-decoration: none; font-size: 0.72rem; white-space: nowrap; }
    .topnav a:hover { color: var(--fg); }
    main { min-height: 70vh; padding: 1rem; }

    @media (min-width: 641px) {
      .topbar { padding: 1rem 1.5rem; padding-top: calc(1rem + env(safe-area-inset-top, 0px)); gap: 1rem; }
      .brand { font-size: 1rem; }
      .topnav { gap: 1.25rem; }
      .topnav a { font-size: 0.9rem; }
      main { padding: 2rem 1.5rem; }
    }
    .sitefoot {
      padding: 0.7rem 1rem;
      padding-bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid var(--border);
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      align-items: center;
    }
    .sitefoot .metadata { font-size: 0.7rem; }

    /* Global deeplink button — small "#" affordance next to section headers.
       Tap copies the current URL (encoding the active variant + section state)
       to clipboard, or opens the native share sheet on mobile. */
    :global(.deeplink) {
      background: transparent;
      border: 0;
      color: var(--fg-muted);
      font-family: var(--font-mono);
      font-size: 0.85em;
      cursor: pointer;
      padding: 0.1em 0.35em;
      margin: 0;
      border-radius: 3px;
      line-height: 1;
      -webkit-tap-highlight-color: transparent;
      vertical-align: baseline;
      opacity: 0.55;
      transition: opacity 0.15s, color 0.15s;
    }
    :global(.deeplink:hover),
    :global(.deeplink:focus-visible) { opacity: 1; color: var(--accent); outline: none; }
    :global(.deeplink:active) { color: var(--accent); }
    :global(.deeplink.copied) {
      color: #39ff14;
      opacity: 1;
    }
    :global(.deeplink.copied::after) { content: ' ✓'; }
    .build-info { font-family: var(--font-mono); font-size: 0.68rem; color: var(--fg-muted); }
    .build-sha { color: var(--fg-muted); text-decoration: none; border-bottom: 1px dotted var(--fg-muted); }
    .build-sha:hover { color: var(--fg); border-bottom-color: var(--fg); }
    .build-sep { opacity: 0.5; margin: 0 0.3em; }

    @media (min-width: 641px) {
      .sitefoot { padding: 1.5rem; gap: 0.4rem; }
      .sitefoot .metadata { font-size: 0.85rem; }
      .build-info { font-size: 0.75rem; }
    }
  </style>
</body>
</html>
