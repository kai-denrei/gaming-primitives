---
import '../styles/tokens.css';
import '../styles/prose.css';
import InstallButton from '../components/InstallButton.astro';
import UpdateToast from '../components/UpdateToast.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import pkg from '../../package.json';
import { execSync } from 'node:child_process';

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
}
const { title, description = 'A catalog of irreducible gameplay primitives.', themeColor = '#0d1117' } = Astro.props;
const base = import.meta.env.BASE_URL;

const buildSha = (() => {
  try {
    const sha = execSync('git rev-parse --short HEAD').toString().trim();
    const dirty = execSync('git status --porcelain').toString().trim();
    return dirty ? `${sha}-dirty` : sha;
  } catch { return 'dev'; }
})();
const buildDate = (() => {
  try { return execSync('git log -1 --format=%cd --date=short').toString().trim(); }
  catch { return new Date().toISOString().slice(0, 10); }
})();
const repoUrl = 'https://github.com/kai-denrei/gaming-primitives';

// Cache-bust token — single-source identity for browser cache, badge, and
// asset URLs. Derived from buildSha so the corner widget, the favicon shape,
// and the ?v= on manifest/icons all agree at any moment in time.
//   clean SHA   → 8 hex chars (e.g. "fcfe0021")
//   dirty tree  → 'd' + 7 chars  (e.g. "dfcfe002") so the favicon cell shifts
const cbCleanSha = buildSha.replace(/-dirty$/, '');
const cbIsDirty = buildSha.endsWith('-dirty');
const cbToken = (cbIsDirty ? 'd' + cbCleanSha : cbCleanSha).padEnd(8, '0').slice(0, 8);
const cbCell = (parseInt(cbToken.slice(0, 2), 16) % 64).toString().padStart(2, '0');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content={themeColor} />
  <meta name="color-scheme" content="dark" />
  <meta name="description" content={description} />
  <!-- Anti-cache hints for the HTML entry. Real cache control lives in HTTP
       headers (Cache-Control: no-cache on HTML); these meta tags are a
       belt-and-braces nudge for browsers and intermediaries that respect them. -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <link rel="manifest" href={`${base}manifest.webmanifest?v=${cbToken}`} />
  <!-- SVG badge favicon first so modern browsers prefer it; PNG kept as
       fallback for older clients. The shape changes every build, giving you
       a glance-test that the new bundle reached the user. -->
  <link rel="icon" type="image/svg+xml" href={`${base}cb-shapes/${cbCell}.svg?v=${cbToken}`} />
  <link rel="icon" href={`${base}icons/favicon-32.png?v=${cbToken}`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon-180.png?v=${cbToken}`} sizes="180x180" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Gaming Primitives" />
  <!-- Token consumed by /cb-badge.js to render the bottom-right shape widget. -->
  <meta name="cb" content={cbToken} />
  <script src={`${base}cb-badge.js?v=${cbToken}`} defer></script>
  <title>{title}</title>
  <script define:vars={{ base }}>
    // Dev escape hatch: ?reset-sw nukes every cache, unregisters SWs, and
    // clears the UpdateToast 24h-dismissal lock. Visit /?reset-sw whenever
    // you suspect the SW lifecycle has wedged.
    if (location.search.includes('reset-sw')) {
      (async () => {
        try {
          if ('serviceWorker' in navigator) {
            const regs = await navigator.serviceWorker.getRegistrations();
            await Promise.all(regs.map(r => r.unregister()));
          }
          if ('caches' in window) {
            const keys = await caches.keys();
            await Promise.all(keys.map(k => caches.delete(k)));
          }
          try { localStorage.removeItem('gp_update_dismissed_until'); } catch (_) {}
        } finally {
          location.replace(location.pathname);
        }
      })();
    } else if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(base + 'sw.js', { scope: base }).catch(() => {});
      });
    }
  </script>
  <script is:inline>
    // Global deeplink delegator. Any element with [data-deeplink] triggers
    // a share/copy of the current URL on click. Uses navigator.share on
    // mobile (opens the iOS share sheet) and clipboard.writeText otherwise.
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-deeplink]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const url = window.location.href;
      try {
        if (navigator.share && /Mobi|Android|iPhone|iPad/.test(navigator.userAgent)) {
          await navigator.share({ url, title: document.title }).catch(() => {});
        } else if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(url);
        }
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1200);
      } catch (_) {}
    });
  </script>
</head>
<body>
  <header class="topbar">
    <a href={base} class="brand">gaming primitives</a>
    <nav class="topnav">
      <button type="button" class="topnav-search" data-gp-search-open aria-label="Search catalog" title="Search (press /)">
        <span aria-hidden="true">⌕</span>
      </button>
      <a href={`${base}p/`}>primitives</a>
      <a href={`${base}a/`}>applied</a>
      <a href={`${base}era/`}>era</a>
      <a href={`${base}about/`}>about</a>
      <InstallButton />
    </nav>
  </header>
  <main><slot /></main>
  <footer class="sitefoot">
    <span class="metadata">primitives ≠ genres ≠ games. <a href={`${base}about/`}>why this exists</a></span>
    <span class="build-info">
      <span class="build-version">v{pkg.version}</span>
      <span class="build-sep">·</span>
      <a class="build-sha" href={`${repoUrl}/commit/${buildSha.replace(/-dirty$/, '')}`} rel="noopener" target="_blank">{buildSha}</a>
      <span class="build-sep">·</span>
      <span class="build-date">{buildDate}</span>
    </span>
  </footer>
  <UpdateToast />
  <SearchOverlay />
  <style>
    /* Mobile-first compact chrome — topbar in one row, small mono. Desktop
       (>=641px) loosens to the original spacing in the @media below. */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1rem;
      padding-top: calc(0.6rem + env(safe-area-inset-top, 0px));
      padding-left: max(1rem, env(safe-area-inset-left, 0px));
      padding-right: max(1rem, env(safe-area-inset-right, 0px));
      border-bottom: 1px solid var(--border);
    }
    .brand { font-family: var(--font-mono); font-weight: 600; color: var(--fg); text-decoration: none; font-size: 0.85rem; line-height: 1.1; flex-shrink: 0; }
    .topnav { display: flex; align-items: center; gap: 0.7rem; }
    .topnav a { font-family: var(--font-mono); color: var(--fg-muted); text-decoration: none; font-size: 0.72rem; white-space: nowrap; }
    .topnav a:hover { color: var(--fg); }
    .topnav-search {
      background: transparent;
      border: 0;
      color: var(--fg-muted);
      cursor: pointer;
      padding: 0.2em 0.4em;
      border-radius: 4px;
      font-size: 1.05rem;
      line-height: 1;
      min-height: 32px;
      min-width: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    .topnav-search:hover, .topnav-search:focus-visible { color: var(--accent); background: rgba(88,166,255,0.08); outline: none; }
    main { min-height: 70vh; padding: 1rem; }

    @media (min-width: 641px) {
      .topbar { padding: 1rem 1.5rem; padding-top: calc(1rem + env(safe-area-inset-top, 0px)); gap: 1rem; }
      .brand { font-size: 1rem; }
      .topnav { gap: 1.25rem; }
      .topnav a { font-size: 0.9rem; }
      main { padding: 2rem 1.5rem; }
    }
    .sitefoot {
      padding: 0.7rem 1rem;
      padding-bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid var(--border);
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      align-items: center;
    }
    .sitefoot .metadata { font-size: 0.7rem; }

    /* Global deeplink button — small "#" affordance next to section headers.
       Tap copies the current URL (encoding the active variant + section state)
       to clipboard, or opens the native share sheet on mobile. */
    :global(.deeplink) {
      background: transparent;
      border: 0;
      color: var(--fg-muted);
      font-family: var(--font-mono);
      font-size: 0.85em;
      cursor: pointer;
      padding: 0.1em 0.35em;
      margin: 0;
      border-radius: 3px;
      line-height: 1;
      -webkit-tap-highlight-color: transparent;
      vertical-align: baseline;
      opacity: 0.55;
      transition: opacity 0.15s, color 0.15s;
    }
    :global(.deeplink:hover),
    :global(.deeplink:focus-visible) { opacity: 1; color: var(--accent); outline: none; }
    :global(.deeplink:active) { color: var(--accent); }
    :global(.deeplink.copied) {
      color: #39ff14;
      opacity: 1;
    }
    :global(.deeplink.copied::after) { content: ' ✓'; }
    .build-info { font-family: var(--font-mono); font-size: 0.68rem; color: var(--fg-muted); }
    .build-sha { color: var(--fg-muted); text-decoration: none; border-bottom: 1px dotted var(--fg-muted); }
    .build-sha:hover { color: var(--fg); border-bottom-color: var(--fg); }
    .build-sep { opacity: 0.5; margin: 0 0.3em; }

    @media (min-width: 641px) {
      .sitefoot { padding: 1.5rem; gap: 0.4rem; }
      .sitefoot .metadata { font-size: 0.85rem; }
      .build-info { font-size: 0.75rem; }
    }
  </style>
</body>
</html>
